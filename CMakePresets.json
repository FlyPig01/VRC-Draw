{
  "version": 8,
  "configurePresets": [
    {
      "name": "mingw-release",
      "displayName": "MinGW Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    }
  ],
  "testPresets": [
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

